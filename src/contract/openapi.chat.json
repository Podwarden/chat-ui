    "/api/chat2/chats/{chat_id}/turn/abort": {
      "post": {
        "tags": [
          "chat2"
        ],
        "summary": "Turn Abort",
        "description": "Explicitly stop the chat's detached turn.\n\nCancels the runner and WAITS for it: when this returns, the partial tail\nis persisted as `aborted` (ledger row included) and the per-chat turn lock\nis released, so the caller can immediately start a new turn without racing\na 409 `turn_in_flight`.",
        "operationId": "turn_abort_api_chat2_chats__chat_id__turn_abort_post",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chat Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true,
                  "title": "Response Turn Abort Api Chat2 Chats  Chat Id  Turn Abort Post"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat2/chats/{chat_id}/turn/live": {
      "get": {
        "tags": [
          "chat2"
        ],
        "summary": "Turn Live",
        "description": "Re-attach to the chat's detached turn.\n\nReplays every frame the original subscriber saw — byte-identical, so the\nfrontend reducer runs the exact same path — then follows the live tail\nuntil the turn is done. A finished turn still replays (and terminates\nimmediately) for `live.DONE_TTL_S` after `done`, which covers the race\nwhere the turn finishes between `GET /chats/{id}` and this request; after\nthe reap it is a 404 with the shared error envelope.",
        "operationId": "turn_live_api_chat2_chats__chat_id__turn_live_get",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chat Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
