      "TextPartIn": {
        "properties": {
          "type": {
            "type": "string",
            "const": "text",
            "title": "Type",
            "default": "text"
          },
          "text": {
            "type": "string",
            "maxLength": 100000,
            "title": "Text"
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "TextPartIn",
        "description": "The only inbound user part shape (images travel as `attachment_ids`).\n\nTyped rather than `dict[str, Any]` so a malformed part -- `{\"type\": \"text\",\n\"text\": 123}` -- is a 422 at the FastAPI boundary instead of a TypeError\ndeep inside the turn, after the upstream socket and the active-request\ncounter have already been taken (T14 review, finding 2)."
      },
