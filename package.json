{
  "name": "@podwarden/chat-ui",
  "version": "0.1.18",
  "description": "Persisted, streaming LLM chat UI + backend contract shared by vLLM Warden and PodWarden Hub",
  "license": "Apache-2.0",
  "author": "The PodWarden Authors",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Podwarden/chat-ui.git"
  },
  "homepage": "https://github.com/Podwarden/chat-ui#readme",
  "bugs": {
    "url": "https://github.com/Podwarden/chat-ui/issues"
  },
  "keywords": [
    "react",
    "chat",
    "llm",
    "streaming",
    "sse",
    "markdown",
    "ai",
    "chatbot",
    "component-library",
    "tailwind"
  ],
  "type": "module",
  "//sideEffects": "src/theme/katex.ts is the SOURCE path and dist/theme/katex.js the built one; both are needed. esbuild resolves this list against source paths while bundling, so without the .ts entry it reports [ignored-bare-import] for markdown.tsx's import and the katex stylesheet survives only by accident (theme/katex is also a tsup entry, and entries are never dropped). The dist path is what a HOST bundler matches.",
  "sideEffects": [
    "**/*.css",
    "src/theme/katex.ts",
    "**/theme/katex.js"
  ],
  "files": [
    "dist",
    "config/tailwind-preset.cjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/contract/index.d.ts",
      "import": "./dist/contract/index.js"
    },
    "./adapters-http": {
      "types": "./dist/adapters/http.d.ts",
      "import": "./dist/adapters/http.js"
    },
    "./conformance": {
      "types": "./dist/conformance/index.d.ts",
      "import": "./dist/conformance/index.js"
    },
    "./theme.css": "./dist/theme.css",
    "./tailwind-preset": "./config/tailwind-preset.cjs",
    "./openapi.chat.json": "./dist/contract/openapi.chat.json"
  },
  "scripts": {
    "build": "tsup --config config/tsup.config.ts && cp src/theme/theme.css dist/theme.css && cp src/contract/openapi.chat.json dist/contract/openapi.chat.json && node scripts/postbuild.mjs",
    "test": "vitest run --config config/vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "screenshots": "playwright test",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vitest": ">=2"
  },
  "//peerDependenciesMeta": "vitest is needed ONLY by the `./conformance` entry, which imports describe/it/expect from it; every other entry is runner-free, so it is optional.",
  "peerDependenciesMeta": {
    "vitest": {
      "optional": true
    }
  },
  "dependencies": {
    "@shikijs/langs": "4.4.3",
    "@shikijs/themes": "4.4.3",
    "clsx": "2.1.1",
    "hast-util-sanitize": "5.0.2",
    "hast-util-to-html": "9.0.5",
    "katex": "0.16.47",
    "lucide-react": "0.460.0",
    "react-markdown": "10.1.0",
    "react-virtuoso": "^4.18.7",
    "rehype-katex": "7.0.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.4.3",
    "swr": "2.3.0",
    "tailwind-merge": "2.5.4",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/hast": "3.0.5",
    "@types/jsdom": "^21.1.7",
    "@types/katex": "0.16.8",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "jsdom": "^25.0.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tsup": "^8.3.5",
    "typescript": "5.6.3",
    "vitest": "2.1.4"
  },
  "engines": {
    "node": ">=20"
  }
}
