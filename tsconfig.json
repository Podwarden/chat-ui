{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM", "DOM.Iterable"], "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "strict": true, "noUncheckedIndexedAccess": false, "skipLibCheck": true,
    "resolveJsonModule": true, "isolatedModules": true, "noEmit": true, "types": ["vitest/globals", "@testing-library/jest-dom", "node"],
    "paths": { "@/*": ["./src/*"] }, "baseUrl": "."
  },
  "include": ["src", "tests", "config/tailwind-preset.cjs", "config/tsup.config.ts", "config/vitest.config.ts"]
}
